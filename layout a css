* {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
}

body {
    padding: 20px;
    font-family: 'Times New Roman', serif;
}

.container {
    display: flex;
    height: 400px;
    border: 1px solid #ccc;
}

.nav {
    flex: 1;
    background-color: pink;
    padding: 15px;
    font-weight: bold;
}

.right-side {
    flex: 4;
    display: flex;
    flex-direction: column;
}

.header {
    background-color: khaki;
    padding: 15px;
    font-weight: bold;
}

.content {
    display: flex;
    flex: 1;
}

.article {
    flex: 3;
    background-color: #fff;
    padding: 15px;
    font-weight: bold;
}

.aside {
    flex: 1;
    background-color: turquoise;
    padding: 15px;
    font-weight: bold;
}

.footer {
    background-color: #f0e68c;
    padding: 15px;
    font-weight: bold;
}
