* {
    box-sizing: border-box;
}

body {
    padding: 20px;
}

.flex-container {
    display: flex;
    flex-direction: column;
    gap: 10px;
    max-width: 800px;
}

.row {
    display: flex;
    gap: 10px;
}

.box {
    background-color: #e0e0e0;
    border: 2px solid #333;
    height: 60px;
    border-radius: 4px;
}

.large {
    flex: 1;
}

.small {
    flex: 1;
}
