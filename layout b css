* {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
}

body {
    padding: 20px;
    font-family: 'Times New Roman', serif;
}

.container {
    display: flex;
    flex-direction: column;
    height: 450px;
    border: 5px solid palevioletred;
    padding: 10px;
    gap: 10px;
}

.header {
    background-color: turquoise;
    padding: 10px;
    text-align: center;
    font-weight: bold;
}

.main {
    display: flex;
    flex: 1;
    gap: 10px;
}

.aside {
    flex: 1;
    background-color: khaki;
    padding: 15px;
    font-weight: bold;
    display: flex;
    align-items: center;
    justify-content: center;
}

.article {
    flex: 2;
    background-color: plum;
    padding: 15px;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
}

.images {
    display: flex;
    gap: 10px;
    margin-top: 20px;
    width: 100%;
    justify-content: center;
}

.img-box {
    background-color: #e0e0e0;
    padding: 20px 15px;
    font-size: 14px;
    border: 1px solid #999;
}

.footer {
    background-color: #40e0d0;
    padding: 10px;
    text-align: center;
    font-weight: bold;
}
