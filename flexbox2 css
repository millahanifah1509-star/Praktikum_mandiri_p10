* {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
}

body {
    font-family: 'Times New Roman', Times, serif;
    padding: 20px;
}

.container {
    display: flex;
    flex-direction: column;
    height: 400px;
    border: 1px solid #ccc;
}

.header {
    background-color: khaki;
    padding: 15px;
    font-weight: bold;
}

.main-content {
    display: flex;
    flex: 1;
}

.article {
    flex: 3;
    background-color: pink;
    padding: 15px;
    font-weight: bold;
}

.nav {
    flex: 1;
    background-color: turquoise;
    padding: 15px;
    font-weight: bold;
}

.footer {
    background-color: #f0e68c;
    padding: 15px;
    font-weight: bold;
}
